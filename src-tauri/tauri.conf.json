{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holocron",
  "version": "0.1.1",
  "identifier": "com.wan2i.holocron",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Holocron",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],

    "category": "Productivity",
    "shortDescription": "A desktop productivity app for managing university work.",
    "longDescription": "Holocron helps students manage subjects, tasks, notes, assignments, projects, tests and deadlines.",

    "publisher": "Wan2i",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}